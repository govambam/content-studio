# Content Studio — Environment Variables
# Copy to .env and fill in values.
# See docs/SETUP-GUIDE.md for how to obtain each one.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Railway / Runtime
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Sentry (API error reporting). Required in production; optional locally.
SENTRY_DSN=https://a95c0bd7c066a275a4b4f1f880223b55@o4511219954548737.ingest.us.sentry.io/4511220499546112

# PagerDuty <-> Macroscope relay (Video 003). See:
#   apps/api/src/routes/pagerdutyWebhook.ts
#   apps/api/src/routes/pagerdutyFindings.ts
# Macroscope Agent webhook target for the PagerDuty relay (required for the inbound forward).
MACROSCOPE_WEBHOOK_URL_PAGERDUTY=
# Shared secret sent as `X-Webhook-Secret` to Macroscope (required).
MACROSCOPE_WEBHOOK_SECRET_PAGERDUTY=
# PagerDuty REST API token used to create incident notes (required).
PAGERDUTY_API_TOKEN=
# `From:` email PagerDuty requires on REST writes. Defaults to ivan@prasso.ai when unset.
PAGERDUTY_FROM_EMAIL=
# Optional in dev. When set, the inbound webhook verifies the V3 HMAC signature.
PAGERDUTY_WEBHOOK_SECRET=
# Optional explicit override for the response-destination URL the relay tells
# Macroscope to call back. When unset, the relay derives it from the inbound
# request's scheme + host. Set this in production for clarity, e.g.
# https://api-production-6f9c.up.railway.app
API_BASE_URL=
